#!/bin/sh
# Build Menagerie.app: bundle the release build, sign it with a Developer ID and the
# hardened runtime, and with --notarize, notarize and staple it.
#
#   scripts/bundle              # target/Menagerie.app, signed
#   scripts/bundle --notarize   # ...and notarized, so the administrator prompt offers Touch ID
#
# Signing uses $MENAGERIE_SIGN_IDENTITY, else the first "Developer ID Application" identity
# in the keychain. Notarizing uses the notarytool keychain profile $MENAGERIE_NOTARY_PROFILE
# (default "menagerie"), created once with `xcrun notarytool store-credentials menagerie`.
#
# macOS offers Touch ID in the administrator prompt only to notarized apps; others get a
# password field and a warning that Apple couldn't check the app.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
notarize=false
for arg in "$@"; do
  case "$arg" in
  --notarize) notarize=true ;;
  *)
    echo "usage: scripts/bundle [--notarize]" >&2
    exit 2
    ;;
  esac
done

version=$(cat macos/VERSION)
identity=${MENAGERIE_SIGN_IDENTITY:-$(security find-identity -v -p codesigning |
  sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -1)}
if [ -z "$identity" ]; then
  echo "No Developer ID Application identity found; set MENAGERIE_SIGN_IDENTITY." >&2
  exit 1
fi

scripts/build-ghostty

swift build --package-path macos -c release
bin=$(swift build --package-path macos -c release --show-bin-path)

app=target/Menagerie.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin/Menagerie" "$app/Contents/MacOS/Menagerie"
cp target/ghostty/bin/MenageriePTYHost "$app/Contents/MacOS/MenageriePTYHost"
cp assets/brand/menubar.png "$app/Contents/Resources/menubar.png"
cp examples/fleet.yaml "$app/Contents/Resources/fleet-example.yaml"
cp assets/brand/Menagerie.icns "$app/Contents/Resources/Menagerie.icns"
cp -R assets/services "$app/Contents/Resources/services"
cat >"$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>me.richardb.menagerie</string>
  <key>CFBundleName</key><string>Menagerie</string>
  <key>CFBundleDisplayName</key><string>Menagerie</string>
  <key>CFBundleExecutable</key><string>Menagerie</string>
  <key>CFBundleIconFile</key><string>Menagerie</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$version</string>
  <key>LSMinimumSystemVersion</key><string>27.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF

codesign --force --options runtime --timestamp --sign "$identity" "$app/Contents/MacOS/MenageriePTYHost"
codesign --force --options runtime --timestamp --sign "$identity" "$app"
codesign --verify --strict --verbose=1 "$app"
echo "Signed $app with $identity"

if $notarize; then
  zip=target/Menagerie.zip
  rm -f "$zip"
  ditto -c -k --keepParent "$app" "$zip"
  xcrun notarytool submit "$zip" --keychain-profile "${MENAGERIE_NOTARY_PROFILE:-menagerie}" --wait
  xcrun stapler staple "$app"
  spctl --assess --type execute --verbose "$app"
  rm -f "$zip"
fi
