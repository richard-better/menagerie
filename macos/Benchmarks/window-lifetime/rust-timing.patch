+static BENCH_WRITE_FD: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(-1);
+extern "C" fn bench_signal(_: libc::c_int) {
+    unsafe {
+        let saved_errno = *libc::__error();
+        let fd = BENCH_WRITE_FD.load(std::sync::atomic::Ordering::Relaxed);
+        if fd >= 0 {
+            let byte = 1u8;
+            libc::write(fd, (&byte as *const u8).cast(), 1);
+        }
+        *libc::__error() = saved_errno;
+    }
